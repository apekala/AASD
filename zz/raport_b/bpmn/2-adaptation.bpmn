<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_adaptation" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_adaptation" name="Process 2 - Plan adaptation after a change">
    <bpmn:participant id="P_trainee" name="Trainee (web app)" />
    <bpmn:participant id="P_coord" name="Coordinator agent" processRef="Proc_P_coord" />
    <bpmn:participant id="P_know" name="Knowledge agent" />
    <bpmn:participant id="P_plan" name="Planning agent" processRef="Proc_P_plan" />
    <bpmn:participant id="P_cal" name="Calendar service" />
    <bpmn:participant id="P_mon" name="Monitoring agent" />
    <bpmn:messageFlow id="Msg_0" name="availability change / missed workout / health change" sourceRef="P_trainee" targetRef="a_change" />
    <bpmn:messageFlow id="Msg_1" name="significant deviation" sourceRef="P_mon" targetRef="a_dev" />
    <bpmn:messageFlow id="Msg_2" name="research query" sourceRef="a_reqk" targetRef="P_know" />
    <bpmn:messageFlow id="Msg_3" name="knowledge brief" sourceRef="P_know" targetRef="a_gotk" />
    <bpmn:messageFlow id="Msg_4" name="change request" sourceRef="a_reqp" targetRef="p_start" />
    <bpmn:messageFlow id="Msg_5" name="free/busy query" sourceRef="p_cal" targetRef="P_cal" />
    <bpmn:messageFlow id="Msg_6" name="free/busy" sourceRef="P_cal" targetRef="p_cal" />
    <bpmn:messageFlow id="Msg_7" name="proposal + explanation, or empty reply" sourceRef="p_end" targetRef="a_gotp" />
    <bpmn:messageFlow id="Msg_8" name="no change needed" sourceRef="a_nochange" targetRef="P_trainee" />
    <bpmn:messageFlow id="Msg_9" name="proposal + explanation" sourceRef="a_present" targetRef="P_trainee" />
    <bpmn:messageFlow id="Msg_10" name="decision" sourceRef="P_trainee" targetRef="a_decision" />
    <bpmn:messageFlow id="Msg_11" name="plan kept" sourceRef="a_kept" targetRef="P_trainee" />
    <bpmn:messageFlow id="Msg_12" name="updated events" sourceRef="a_cal" targetRef="P_cal" />
    <bpmn:messageFlow id="Msg_13" name="plan updated" sourceRef="a_mon" targetRef="P_mon" />
    <bpmn:messageFlow id="Msg_14" name="confirmation" sourceRef="a_confirm" targetRef="P_trainee" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_P_coord" isExecutable="false">
    <bpmn:startEvent id="a_change" name="Change reported">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
      <bpmn:messageEventDefinition id="a_change_def" />
    </bpmn:startEvent>
    <bpmn:startEvent id="a_dev" name="Deviation reported">
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:messageEventDefinition id="a_dev_def" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="a_merge" name="">
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="a_covers" name="Brief covers the change?">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="a_reqk" name="Send research query">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="a_reqk_def" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="a_gotk" name="Brief received">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="a_gotk_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="a_m2" name="">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="a_reqp" name="Send change request">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="a_reqp_def" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="a_gotp" name="Reply received">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:messageEventDefinition id="a_gotp_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="a_prop" name="Proposal?">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="a_nochange" name="No change needed">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:messageEventDefinition id="a_nochange_def" />
    </bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="a_present" name="Present proposal">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:messageEventDefinition id="a_present_def" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="a_decision" name="Decision received">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
      <bpmn:messageEventDefinition id="a_decision_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="a_acc" name="Accepted?">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="a_reject" name="Record rejection">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="a_kept" name="Plan kept">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:messageEventDefinition id="a_kept_def" />
    </bpmn:endEvent>
    <bpmn:task id="a_save" name="Save plan version">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="a_cal" name="Update calendar">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateThrowEvent id="a_mon" name="Send plan updated">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
      <bpmn:messageEventDefinition id="a_mon_def" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="a_confirm" name="Change confirmed">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:messageEventDefinition id="a_confirm_def" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" name="" sourceRef="a_change" targetRef="a_merge" />
    <bpmn:sequenceFlow id="Flow_1" name="" sourceRef="a_merge" targetRef="a_covers" />
    <bpmn:sequenceFlow id="Flow_2" name="" sourceRef="a_dev" targetRef="a_merge" />
    <bpmn:sequenceFlow id="Flow_3" name="" sourceRef="a_reqk" targetRef="a_gotk" />
    <bpmn:sequenceFlow id="Flow_4" name="" sourceRef="a_gotk" targetRef="a_m2" />
    <bpmn:sequenceFlow id="Flow_5" name="" sourceRef="a_m2" targetRef="a_reqp" />
    <bpmn:sequenceFlow id="Flow_6" name="" sourceRef="a_reqp" targetRef="a_gotp" />
    <bpmn:sequenceFlow id="Flow_7" name="" sourceRef="a_gotp" targetRef="a_prop" />
    <bpmn:sequenceFlow id="Flow_8" name="" sourceRef="a_present" targetRef="a_decision" />
    <bpmn:sequenceFlow id="Flow_9" name="" sourceRef="a_decision" targetRef="a_acc" />
    <bpmn:sequenceFlow id="Flow_10" name="" sourceRef="a_reject" targetRef="a_kept" />
    <bpmn:sequenceFlow id="Flow_11" name="" sourceRef="a_save" targetRef="a_cal" />
    <bpmn:sequenceFlow id="Flow_12" name="" sourceRef="a_cal" targetRef="a_mon" />
    <bpmn:sequenceFlow id="Flow_13" name="" sourceRef="a_mon" targetRef="a_confirm" />
    <bpmn:sequenceFlow id="Flow_14" name="yes" sourceRef="a_covers" targetRef="a_m2" />
    <bpmn:sequenceFlow id="Flow_15" name="no" sourceRef="a_covers" targetRef="a_reqk" />
    <bpmn:sequenceFlow id="Flow_16" name="no" sourceRef="a_prop" targetRef="a_nochange" />
    <bpmn:sequenceFlow id="Flow_17" name="yes" sourceRef="a_prop" targetRef="a_present" />
    <bpmn:sequenceFlow id="Flow_18" name="yes" sourceRef="a_acc" targetRef="a_save" />
    <bpmn:sequenceFlow id="Flow_19" name="no" sourceRef="a_acc" targetRef="a_reject" />
  </bpmn:process>
  <bpmn:process id="Proc_P_plan" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P_plan">
      <bpmn:lane id="L_planner" name="Planner">
        <bpmn:flowNodeRef>p_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p_assess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p_needed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p_cal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p_draft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p_valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_explainer" name="Explainer">
        <bpmn:flowNodeRef>x_explain</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="p_start" name="Request received">
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
      <bpmn:messageEventDefinition id="p_start_def" />
    </bpmn:startEvent>
    <bpmn:task id="p_assess" name="Assess impact on the plan">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="p_needed" name="Change needed?">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_27</bpmn:outgoing>
      <bpmn:outgoing>Flow_28</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="p_cal" name="Read calendar availability">
      <bpmn:incoming>Flow_27</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="p_draft" name="Draft modification">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:incoming>Flow_30</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="p_check" name="Check hard constraints">
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="p_valid" name="Valid?">
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:outgoing>Flow_29</bpmn:outgoing>
      <bpmn:outgoing>Flow_30</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="x_explain" name="Write explanation (+ disclaimer after a health change)">
      <bpmn:incoming>Flow_29</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="p_merge" name="">
      <bpmn:incoming>Flow_25</bpmn:incoming>
      <bpmn:incoming>Flow_28</bpmn:incoming>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="p_end" name="Send reply">
      <bpmn:incoming>Flow_26</bpmn:incoming>
      <bpmn:messageEventDefinition id="p_end_def" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_20" name="" sourceRef="p_start" targetRef="p_assess" />
    <bpmn:sequenceFlow id="Flow_21" name="" sourceRef="p_assess" targetRef="p_needed" />
    <bpmn:sequenceFlow id="Flow_22" name="" sourceRef="p_cal" targetRef="p_draft" />
    <bpmn:sequenceFlow id="Flow_23" name="" sourceRef="p_draft" targetRef="p_check" />
    <bpmn:sequenceFlow id="Flow_24" name="" sourceRef="p_check" targetRef="p_valid" />
    <bpmn:sequenceFlow id="Flow_25" name="" sourceRef="x_explain" targetRef="p_merge" />
    <bpmn:sequenceFlow id="Flow_26" name="" sourceRef="p_merge" targetRef="p_end" />
    <bpmn:sequenceFlow id="Flow_27" name="yes" sourceRef="p_needed" targetRef="p_cal" />
    <bpmn:sequenceFlow id="Flow_28" name="no (empty reply)" sourceRef="p_needed" targetRef="p_merge" />
    <bpmn:sequenceFlow id="Flow_29" name="yes" sourceRef="p_valid" targetRef="x_explain" />
    <bpmn:sequenceFlow id="Flow_30" name="no" sourceRef="p_valid" targetRef="p_draft" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collab_adaptation">
      <bpmndi:BPMNShape id="P_trainee_di" bpmnElement="P_trainee" isHorizontal="false">
        <dc:Bounds x="0" y="0" width="50" height="2695" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_coord_di" bpmnElement="P_coord" isHorizontal="false">
        <dc:Bounds x="95" y="0" width="375" height="2695" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_know_di" bpmnElement="P_know" isHorizontal="false">
        <dc:Bounds x="515" y="0" width="50" height="2695" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_plan_di" bpmnElement="P_plan" isHorizontal="false">
        <dc:Bounds x="610" y="0" width="375" height="2695" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_planner_di" bpmnElement="L_planner" isHorizontal="false">
        <dc:Bounds x="610" y="30" width="250" height="2665" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_explainer_di" bpmnElement="L_explainer" isHorizontal="false">
        <dc:Bounds x="860" y="30" width="125" height="2665" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_cal_di" bpmnElement="P_cal" isHorizontal="false">
        <dc:Bounds x="1030" y="0" width="50" height="2695" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_mon_di" bpmnElement="P_mon" isHorizontal="false">
        <dc:Bounds x="1125" y="0" width="50" height="2695" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="a_change_di" bpmnElement="a_change">
        <dc:Bounds x="264.5" y="94.5" width="36.0" height="36.0" />
        <bpmndi:BPMNLabel><dc:Bounds x="287.5" y="132.5" width="68" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="a_dev_di" bpmnElement="a_dev">
        <dc:Bounds x="389.5" y="94.5" width="36.0" height="36.0" />
        <bpmndi:BPMNLabel><dc:Bounds x="412.5" y="132.5" width="68" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="a_merge_di" bpmnElement="a_merge" isMarkerVisible="true">
        <dc:Bounds x="257.5" y="192.5" width="50.0" height="50.0" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="a_covers_di" bpmnElement="a_covers" isMarkerVisible="true">
        <dc:Bounds x="257.5" y="297.5" width="50.0" height="50.0" />
        <bpmndi:BPMNLabel><dc:Bounds x="192.5" y="274.5" width="82" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="a_reqk_di" bpmnElement="a_reqk">
        <dc:Bounds x="389.5" y="409.5" width="36.0" height="36.0" />
        <bpmndi:BPMNLabel><dc:Bounds x="412.5" y="447.5" width="68" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="a_gotk_di" bpmnElement="a_gotk">
        <dc:Bounds x="389.5" y="514.5" width="36.0" height="36.0" />
        <bpmndi:BPMNLabel><dc:Bounds x="412.5" y="552.5" width="68" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="a_m2_di" bpmnElement="a_m2" isMarkerVisible="true">
        <dc:Bounds x="257.5" y="612.5" width="50.0" height="50.0" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="a_reqp_di" bpmnElement="a_reqp">
        <dc:Bounds x="264.5" y="724.5" width="36.0" height="36.0" />
        <bpmndi:BPMNLabel><dc:Bounds x="287.5" y="762.5" width="68" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="a_gotp_di" bpmnElement="a_gotp">
        <dc:Bounds x="264.5" y="1669.5" width="36.0" height="36.0" />
        <bpmndi:BPMNLabel><dc:Bounds x="287.5" y="1707.5" width="68" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="a_prop_di" bpmnElement="a_prop" isMarkerVisible="true">
        <dc:Bounds x="257.5" y="1767.5" width="50.0" height="50.0" />
        <bpmndi:BPMNLabel><dc:Bounds x="290.5" y="1744.5" width="82" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="a_nochange_di" bpmnElement="a_nochange">
        <dc:Bounds x="139.5" y="1879.5" width="36.0" height="36.0" />
        <bpmndi:BPMNLabel><dc:Bounds x="162.5" y="1917.5" width="68" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="a_present_di" bpmnElement="a_present">
        <dc:Bounds x="264.5" y="1984.5" width="36.0" height="36.0" />
        <bpmndi:BPMNLabel><dc:Bounds x="287.5" y="2022.5" width="68" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="a_decision_di" bpmnElement="a_decision">
        <dc:Bounds x="264.5" y="2089.5" width="36.0" height="36.0" />
        <bpmndi:BPMNLabel><dc:Bounds x="287.5" y="2127.5" width="68" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="a_acc_di" bpmnElement="a_acc" isMarkerVisible="true">
        <dc:Bounds x="257.5" y="2187.5" width="50.0" height="50.0" />
        <bpmndi:BPMNLabel><dc:Bounds x="290.5" y="2164.5" width="82" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="a_reject_di" bpmnElement="a_reject">
        <dc:Bounds x="107.5" y="2277.5" width="100.0" height="80.0" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="a_kept_di" bpmnElement="a_kept">
        <dc:Bounds x="139.5" y="2404.5" width="36.0" height="36.0" />
        <bpmndi:BPMNLabel><dc:Bounds x="162.5" y="2442.5" width="68" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="a_save_di" bpmnElement="a_save">
        <dc:Bounds x="232.5" y="2277.5" width="100.0" height="80.0" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="a_cal_di" bpmnElement="a_cal">
        <dc:Bounds x="232.5" y="2382.5" width="100.0" height="80.0" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="a_mon_di" bpmnElement="a_mon">
        <dc:Bounds x="264.5" y="2509.5" width="36.0" height="36.0" />
        <bpmndi:BPMNLabel><dc:Bounds x="287.5" y="2547.5" width="68" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="a_confirm_di" bpmnElement="a_confirm">
        <dc:Bounds x="264.5" y="2614.5" width="36.0" height="36.0" />
        <bpmndi:BPMNLabel><dc:Bounds x="287.5" y="2652.5" width="68" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p_start_di" bpmnElement="p_start">
        <dc:Bounds x="779.5" y="724.5" width="36.0" height="36.0" />
        <bpmndi:BPMNLabel><dc:Bounds x="802.5" y="762.5" width="68" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p_assess_di" bpmnElement="p_assess">
        <dc:Bounds x="747.5" y="807.5" width="100.0" height="80.0" />
