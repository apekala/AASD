<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_health" targetNamespace="http://bpmn.io/schema/bpmn" exporter="hand-written" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_health" name="Process 4 - Injury, illness and recovery reports">
    <bpmn:participant id="P_trainee" name="Trainee (web app)" />
    <bpmn:participant id="P_coord" name="Coordinator agent" processRef="Proc_coord" />
    <bpmn:participant id="P_know" name="Knowledge agent" />
    <bpmn:participant id="P_plan" name="Planning agent" processRef="Proc_plan" />
    <bpmn:participant id="P_cal" name="Calendar service" />
    <bpmn:participant id="P_expl" name="Explanation agent" />
    <bpmn:participant id="P_mon" name="Monitoring agent" />
    <bpmn:messageFlow id="Msg_trainee_h_start" name="injury, illness or recovery report" sourceRef="P_trainee" targetRef="h_start" />
    <bpmn:messageFlow id="Msg_h_reqk_know" name="research query" sourceRef="h_reqk" targetRef="P_know" />
    <bpmn:messageFlow id="Msg_know_h_gotk" name="knowledge brief" sourceRef="P_know" targetRef="h_gotk" />
    <bpmn:messageFlow id="Msg_h_reqp_p_start" name="health report + context" sourceRef="h_reqp" targetRef="p_start" />
    <bpmn:messageFlow id="Msg_p_cal_cal" name="free/busy query" sourceRef="p_cal" targetRef="P_cal" />
    <bpmn:messageFlow id="Msg_cal_p_cal" name="free/busy" sourceRef="P_cal" targetRef="p_cal" />
    <bpmn:messageFlow id="Msg_p_end_h_gotp" name="proposal" sourceRef="p_end" targetRef="h_gotp" />
    <bpmn:messageFlow id="Msg_h_reqe_expl" name="proposal" sourceRef="h_reqe" targetRef="P_expl" />
    <bpmn:messageFlow id="Msg_expl_h_gote" name="explanation" sourceRef="P_expl" targetRef="h_gote" />
    <bpmn:messageFlow id="Msg_h_present_trainee" name="proposal + explanation" sourceRef="h_present" targetRef="P_trainee" />
    <bpmn:messageFlow id="Msg_trainee_h_decision" name="decision (+ reason)" sourceRef="P_trainee" targetRef="h_decision" />
    <bpmn:messageFlow id="Msg_h_warn_trainee" name="warning" sourceRef="h_warn" targetRef="P_trainee" />
    <bpmn:messageFlow id="Msg_h_kept_trainee" name="plan kept" sourceRef="h_kept" targetRef="P_trainee" />
    <bpmn:messageFlow id="Msg_h_calendar_cal" name="updated / removed events" sourceRef="h_calendar" targetRef="P_cal" />
    <bpmn:messageFlow id="Msg_h_notify_mon" name="plan updated" sourceRef="h_notify" targetRef="P_mon" />
    <bpmn:messageFlow id="Msg_h_done_trainee" name="confirmation" sourceRef="h_done" targetRef="P_trainee" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_coord" isExecutable="false">
    <bpmn:laneSet id="LaneSet_coord">
      <bpmn:lane id="Lane_uh" name="UserHandler">
        <bpmn:flowNodeRef>h_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_present</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_wm" name="WorkflowManager">
        <bpmn:flowNodeRef>h_covered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_reqk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_gotk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_kmerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_retry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_reqp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_gotp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_reqe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_gote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_accepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_issusp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_log</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_warn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_attempts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_kept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_commit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_calendar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h_notify</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="h_start" name="Health report received"><bpmn:outgoing>Flow_h_start_h_covered</bpmn:outgoing><bpmn:messageEventDefinition id="h_start_md" /></bpmn:startEvent>
    <bpmn:exclusiveGateway id="h_covered" name="Brief covers it?"><bpmn:incoming>Flow_h_start_h_covered</bpmn:incoming><bpmn:outgoing>Flow_h_covered_h_reqk</bpmn:outgoing><bpmn:outgoing>Flow_h_covered_h_kmerge</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="h_reqk" name="Request knowledge"><bpmn:incoming>Flow_h_covered_h_reqk</bpmn:incoming><bpmn:outgoing>Flow_h_reqk_h_gotk</bpmn:outgoing><bpmn:messageEventDefinition id="h_reqk_md" /></bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="h_gotk" name="Brief received"><bpmn:incoming>Flow_h_reqk_h_gotk</bpmn:incoming><bpmn:outgoing>Flow_h_gotk_h_kmerge</bpmn:outgoing><bpmn:messageEventDefinition id="h_gotk_md" /></bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="h_kmerge" name=""><bpmn:incoming>Flow_h_gotk_h_kmerge</bpmn:incoming><bpmn:incoming>Flow_h_covered_h_kmerge</bpmn:incoming><bpmn:outgoing>Flow_h_kmerge_h_retry</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="h_retry" name=""><bpmn:incoming>Flow_h_kmerge_h_retry</bpmn:incoming><bpmn:incoming>Flow_h_attempts_h_retry</bpmn:incoming><bpmn:outgoing>Flow_h_retry_h_reqp</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="h_reqp" name="Request plan change"><bpmn:incoming>Flow_h_retry_h_reqp</bpmn:incoming><bpmn:outgoing>Flow_h_reqp_h_gotp</bpmn:outgoing><bpmn:messageEventDefinition id="h_reqp_md" /></bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="h_gotp" name="Proposal received"><bpmn:incoming>Flow_h_reqp_h_gotp</bpmn:incoming><bpmn:outgoing>Flow_h_gotp_h_reqe</bpmn:outgoing><bpmn:messageEventDefinition id="h_gotp_md" /></bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="h_reqe" name="Request explanation"><bpmn:incoming>Flow_h_gotp_h_reqe</bpmn:incoming><bpmn:outgoing>Flow_h_reqe_h_gote</bpmn:outgoing><bpmn:messageEventDefinition id="h_reqe_md" /></bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="h_gote" name="Explanation received"><bpmn:incoming>Flow_h_reqe_h_gote</bpmn:incoming><bpmn:outgoing>Flow_h_gote_h_present</bpmn:outgoing><bpmn:messageEventDefinition id="h_gote_md" /></bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="h_present" name="Present proposal"><bpmn:incoming>Flow_h_gote_h_present</bpmn:incoming><bpmn:outgoing>Flow_h_present_h_decision</bpmn:outgoing><bpmn:messageEventDefinition id="h_present_md" /></bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="h_decision" name="Decision received"><bpmn:incoming>Flow_h_present_h_decision</bpmn:incoming><bpmn:outgoing>Flow_h_decision_h_accepted</bpmn:outgoing><bpmn:messageEventDefinition id="h_decision_md" /></bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="h_accepted" name="Accepted?"><bpmn:incoming>Flow_h_decision_h_accepted</bpmn:incoming><bpmn:outgoing>Flow_h_accepted_h_commit</bpmn:outgoing><bpmn:outgoing>Flow_h_accepted_h_issusp</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="h_issusp" name="Suspension proposal?"><bpmn:incoming>Flow_h_accepted_h_issusp</bpmn:incoming><bpmn:outgoing>Flow_h_issusp_h_log</bpmn:outgoing><bpmn:outgoing>Flow_h_issusp_h_attempts</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="h_log" name="Log declined suspension"><bpmn:incoming>Flow_h_issusp_h_log</bpmn:incoming><bpmn:outgoing>Flow_h_log_h_warn</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="h_warn" name="Warning shown, current plan kept"><bpmn:incoming>Flow_h_log_h_warn</bpmn:incoming><bpmn:messageEventDefinition id="h_warn_md" /></bpmn:endEvent>
    <bpmn:exclusiveGateway id="h_attempts" name="Attempts left?"><bpmn:incoming>Flow_h_issusp_h_attempts</bpmn:incoming><bpmn:outgoing>Flow_h_attempts_h_retry</bpmn:outgoing><bpmn:outgoing>Flow_h_attempts_h_kept</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="h_kept" name="Current plan kept, trainee told"><bpmn:incoming>Flow_h_attempts_h_kept</bpmn:incoming><bpmn:messageEventDefinition id="h_kept_md" /></bpmn:endEvent>
    <bpmn:task id="h_commit" name="Save plan version (active or suspended)"><bpmn:incoming>Flow_h_accepted_h_commit</bpmn:incoming><bpmn:outgoing>Flow_h_commit_h_calendar</bpmn:outgoing></bpmn:task>
    <bpmn:task id="h_calendar" name="Update calendar"><bpmn:incoming>Flow_h_commit_h_calendar</bpmn:incoming><bpmn:outgoing>Flow_h_calendar_h_notify</bpmn:outgoing></bpmn:task>
    <bpmn:intermediateThrowEvent id="h_notify" name="Notify monitoring"><bpmn:incoming>Flow_h_calendar_h_notify</bpmn:incoming><bpmn:outgoing>Flow_h_notify_h_done</bpmn:outgoing><bpmn:messageEventDefinition id="h_notify_md" /></bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="h_done" name="Change confirmed"><bpmn:incoming>Flow_h_notify_h_done</bpmn:incoming><bpmn:messageEventDefinition id="h_done_md" /></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_h_start_h_covered" sourceRef="h_start" targetRef="h_covered" />
    <bpmn:sequenceFlow id="Flow_h_covered_h_reqk" name="no" sourceRef="h_covered" targetRef="h_reqk" />
    <bpmn:sequenceFlow id="Flow_h_reqk_h_gotk" sourceRef="h_reqk" targetRef="h_gotk" />
    <bpmn:sequenceFlow id="Flow_h_gotk_h_kmerge" sourceRef="h_gotk" targetRef="h_kmerge" />
    <bpmn:sequenceFlow id="Flow_h_covered_h_kmerge" name="yes" sourceRef="h_covered" targetRef="h_kmerge" />
    <bpmn:sequenceFlow id="Flow_h_kmerge_h_retry" sourceRef="h_kmerge" targetRef="h_retry" />
    <bpmn:sequenceFlow id="Flow_h_retry_h_reqp" sourceRef="h_retry" targetRef="h_reqp" />
    <bpmn:sequenceFlow id="Flow_h_reqp_h_gotp" sourceRef="h_reqp" targetRef="h_gotp" />
    <bpmn:sequenceFlow id="Flow_h_gotp_h_reqe" sourceRef="h_gotp" targetRef="h_reqe" />
    <bpmn:sequenceFlow id="Flow_h_reqe_h_gote" sourceRef="h_reqe" targetRef="h_gote" />
    <bpmn:sequenceFlow id="Flow_h_gote_h_present" sourceRef="h_gote" targetRef="h_present" />
    <bpmn:sequenceFlow id="Flow_h_present_h_decision" sourceRef="h_present" targetRef="h_decision" />
    <bpmn:sequenceFlow id="Flow_h_decision_h_accepted" sourceRef="h_decision" targetRef="h_accepted" />
    <bpmn:sequenceFlow id="Flow_h_accepted_h_commit" name="yes" sourceRef="h_accepted" targetRef="h_commit" />
    <bpmn:sequenceFlow id="Flow_h_accepted_h_issusp" name="no" sourceRef="h_accepted" targetRef="h_issusp" />
    <bpmn:sequenceFlow id="Flow_h_issusp_h_log" name="yes" sourceRef="h_issusp" targetRef="h_log" />
    <bpmn:sequenceFlow id="Flow_h_log_h_warn" sourceRef="h_log" targetRef="h_warn" />
    <bpmn:sequenceFlow id="Flow_h_issusp_h_attempts" name="no" sourceRef="h_issusp" targetRef="h_attempts" />
    <bpmn:sequenceFlow id="Flow_h_attempts_h_retry" name="yes" sourceRef="h_attempts" targetRef="h_retry" />
    <bpmn:sequenceFlow id="Flow_h_attempts_h_kept" name="no" sourceRef="h_attempts" targetRef="h_kept" />
    <bpmn:sequenceFlow id="Flow_h_commit_h_calendar" sourceRef="h_commit" targetRef="h_calendar" />
    <bpmn:sequenceFlow id="Flow_h_calendar_h_notify" sourceRef="h_calendar" targetRef="h_notify" />
    <bpmn:sequenceFlow id="Flow_h_notify_h_done" sourceRef="h_notify" targetRef="h_done" />
  </bpmn:process>
  <bpmn:process id="Proc_plan" isExecutable="false">
    <bpmn:startEvent id="p_start" name="Health report forwarded"><bpmn:outgoing>Flow_p_start_p_screen</bpmn:outgoing><bpmn:messageEventDefinition id="p_start_md" /></bpmn:startEvent>
    <bpmn:task id="p_screen" name="Screen for red flags"><bpmn:incoming>Flow_p_start_p_screen</bpmn:incoming><bpmn:outgoing>Flow_p_screen_p_red</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="p_red" name="Red flag?"><bpmn:incoming>Flow_p_screen_p_red</bpmn:incoming><bpmn:outgoing>Flow_p_red_p_kind</bpmn:outgoing><bpmn:outgoing>Flow_p_red_p_susp</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="p_kind" name="Report type?"><bpmn:incoming>Flow_p_red_p_kind</bpmn:incoming><bpmn:incoming>Flow_p_valid_p_kind</bpmn:incoming><bpmn:outgoing>Flow_p_kind_p_reduced</bpmn:outgoing><bpmn:outgoing>Flow_p_kind_p_return</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="p_reduced" name="Draft reduced plan with disclaimer"><bpmn:incoming>Flow_p_kind_p_reduced</bpmn:incoming><bpmn:outgoing>Flow_p_reduced_p_dmerge</bpmn:outgoing></bpmn:task>
    <bpmn:task id="p_return" name="Draft return-to-training plan"><bpmn:incoming>Flow_p_kind_p_return</bpmn:incoming><bpmn:outgoing>Flow_p_return_p_dmerge</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="p_dmerge" name=""><bpmn:incoming>Flow_p_reduced_p_dmerge</bpmn:incoming><bpmn:incoming>Flow_p_return_p_dmerge</bpmn:incoming><bpmn:outgoing>Flow_p_dmerge_p_cal</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="p_cal" name="Read calendar availability"><bpmn:incoming>Flow_p_dmerge_p_cal</bpmn:incoming><bpmn:outgoing>Flow_p_cal_p_check</bpmn:outgoing></bpmn:task>
    <bpmn:task id="p_check" name="Check hard constraints"><bpmn:incoming>Flow_p_cal_p_check</bpmn:incoming><bpmn:outgoing>Flow_p_check_p_valid</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="p_valid" name="Valid?"><bpmn:incoming>Flow_p_check_p_valid</bpmn:incoming><bpmn:outgoing>Flow_p_valid_p_kind</bpmn:outgoing><bpmn:outgoing>Flow_p_valid_p_merge</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="p_susp" name="Prepare suspension proposal"><bpmn:incoming>Flow_p_red_p_susp</bpmn:incoming><bpmn:outgoing>Flow_p_susp_p_merge</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="p_merge" name=""><bpmn:incoming>Flow_p_valid_p_merge</bpmn:incoming><bpmn:incoming>Flow_p_susp_p_merge</bpmn:incoming><bpmn:outgoing>Flow_p_merge_p_end</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="p_end" name="Send proposal"><bpmn:incoming>Flow_p_merge_p_end</bpmn:incoming><bpmn:messageEventDefinition id="p_end_md" /></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_p_start_p_screen" sourceRef="p_start" targetRef="p_screen" />
    <bpmn:sequenceFlow id="Flow_p_screen_p_red" sourceRef="p_screen" targetRef="p_red" />
    <bpmn:sequenceFlow id="Flow_p_red_p_kind" name="no" sourceRef="p_red" targetRef="p_kind" />
    <bpmn:sequenceFlow id="Flow_p_red_p_susp" name="yes" sourceRef="p_red" targetRef="p_susp" />
    <bpmn:sequenceFlow id="Flow_p_kind_p_reduced" name="injury / illness" sourceRef="p_kind" targetRef="p_reduced" />
    <bpmn:sequenceFlow id="Flow_p_kind_p_return" name="recovery" sourceRef="p_kind" targetRef="p_return" />
    <bpmn:sequenceFlow id="Flow_p_reduced_p_dmerge" sourceRef="p_reduced" targetRef="p_dmerge" />
    <bpmn:sequenceFlow id="Flow_p_return_p_dmerge" sourceRef="p_return" targetRef="p_dmerge" />
    <bpmn:sequenceFlow id="Flow_p_dmerge_p_cal" sourceRef="p_dmerge" targetRef="p_cal" />
    <bpmn:sequenceFlow id="Flow_p_cal_p_check" sourceRef="p_cal" targetRef="p_check" />
    <bpmn:sequenceFlow id="Flow_p_check_p_valid" sourceRef="p_check" targetRef="p_valid" />
    <bpmn:sequenceFlow id="Flow_p_valid_p_kind" name="no" sourceRef="p_valid" targetRef="p_kind" />
    <bpmn:sequenceFlow id="Flow_p_valid_p_merge" name="yes" sourceRef="p_valid" targetRef="p_merge" />
    <bpmn:sequenceFlow id="Flow_p_susp_p_merge" sourceRef="p_susp" targetRef="p_merge" />
    <bpmn:sequenceFlow id="Flow_p_merge_p_end" sourceRef="p_merge" targetRef="p_end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_health">
    <bpmndi:BPMNPlane id="Plane_health" bpmnElement="Collab_health">
      <bpmndi:BPMNShape id="P_trainee_di" bpmnElement="P_trainee" isHorizontal="true"><dc:Bounds x="100" y="60" width="4020" height="60" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_coord_di" bpmnElement="P_coord" isHorizontal="true"><dc:Bounds x="100" y="170" width="4020" height="460" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_uh_di" bpmnElement="Lane_uh" isHorizontal="true"><dc:Bounds x="130" y="170" width="3990" height="120" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_wm_di" bpmnElement="Lane_wm" isHorizontal="true"><dc:Bounds x="130" y="290" width="3990" height="340" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_know_di" bpmnElement="P_know" isHorizontal="true"><dc:Bounds x="100" y="680" width="4020" height="60" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_plan_di" bpmnElement="P_plan" isHorizontal="true"><dc:Bounds x="100" y="790" width="4020" height="340" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_cal_di" bpmnElement="P_cal" isHorizontal="true"><dc:Bounds x="100" y="1180" width="4020" height="60" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_expl_di" bpmnElement="P_expl" isHorizontal="true"><dc:Bounds x="100" y="1290" width="4020" height="60" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_mon_di" bpmnElement="P_mon" isHorizontal="true"><dc:Bounds x="100" y="1400" width="4020" height="60" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="h_start_di" bpmnElement="h_start"><dc:Bounds x="212" y="212" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="175" y="252" width="110" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="h_covered_di" bpmnElement="h_covered" isMarkerVisible="true"><dc:Bounds x="345" y="325" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="315" y="379" width="110" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="h_reqk_di" bpmnElement="h_reqk"><dc:Bounds x="492" y="442" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="455" y="482" width="110" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="h_gotk_di" bpmnElement="h_gotk"><dc:Bounds x="632" y="442" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="595" y="482" width="110" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="h_kmerge_di" bpmnElement="h_kmerge" isMarkerVisible="true"><dc:Bounds x="765" y="325" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="h_retry_di" bpmnElement="h_retry" isMarkerVisible="true"><dc:Bounds x="905" y="325" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="h_reqp_di" bpmnElement="h_reqp"><dc:Bounds x="1052" y="332" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1015" y="372" width="110" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="h_gotp_di" bpmnElement="h_gotp"><dc:Bounds x="2312" y="332" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="2275" y="372" width="110" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="h_reqe_di" bpmnElement="h_reqe"><dc:Bounds x="2452" y="332" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="2415" y="372" width="110" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
