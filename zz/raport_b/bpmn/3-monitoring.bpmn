<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_monitoring" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_monitoring" name="Process 3 - Progress monitoring">
    <bpmn:participant id="P_trainee" name="Trainee (web app)" />
    <bpmn:participant id="P_mon" name="Monitoring agent" processRef="Proc_P_mon" />
    <bpmn:participant id="P_act" name="Activity platform (via backend)" />
    <bpmn:participant id="P_coord" name="Coordinator agent" />
    <bpmn:messageFlow id="Msg_0" name="survey / manual entry" sourceRef="P_trainee" targetRef="m_survey" />
    <bpmn:messageFlow id="Msg_1" name="new activity" sourceRef="P_act" targetRef="m_activity" />
    <bpmn:messageFlow id="Msg_2" name="accepted plan (process 1)" sourceRef="P_coord" targetRef="m_start" />
    <bpmn:messageFlow id="Msg_3" name="plan updated (process 2)" sourceRef="P_coord" targetRef="m_upd" />
    <bpmn:messageFlow id="Msg_4" name="significant deviation (process 2)" sourceRef="m_dev" targetRef="P_coord" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_P_mon" isExecutable="false">
    <bpmn:startEvent id="m_start" name="Accepted plan received">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
      <bpmn:messageEventDefinition id="m_start_def" />
    </bpmn:startEvent>
    <bpmn:task id="m_load" name="Load plan version">
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="m_merge" name="">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:eventBasedGateway id="m_evgw" name="">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="m_survey" name="Survey or manual entry received">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:messageEventDefinition id="m_survey_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="m_activity" name="Activity synced">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:messageEventDefinition id="m_activity_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="m_upd" name="Plan updated">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="m_upd_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="m_load2" name="Load new plan version">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="m_cmpmerge" name="">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="m_cmp" name="Compare with plan">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="m_sig" name="Significant deviation?">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="m_dev" name="Send deviation">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
      <bpmn:messageEventDefinition id="m_dev_def" />
    </bpmn:intermediateThrowEvent>
    <bpmn:sequenceFlow id="Flow_0" name="" sourceRef="m_start" targetRef="m_load" />
    <bpmn:sequenceFlow id="Flow_1" name="" sourceRef="m_load" targetRef="m_merge" />
    <bpmn:sequenceFlow id="Flow_2" name="" sourceRef="m_merge" targetRef="m_evgw" />
    <bpmn:sequenceFlow id="Flow_3" name="" sourceRef="m_evgw" targetRef="m_survey" />
    <bpmn:sequenceFlow id="Flow_4" name="" sourceRef="m_evgw" targetRef="m_activity" />
    <bpmn:sequenceFlow id="Flow_5" name="" sourceRef="m_evgw" targetRef="m_upd" />
    <bpmn:sequenceFlow id="Flow_6" name="" sourceRef="m_upd" targetRef="m_load2" />
    <bpmn:sequenceFlow id="Flow_7" name="" sourceRef="m_survey" targetRef="m_cmpmerge" />
    <bpmn:sequenceFlow id="Flow_8" name="" sourceRef="m_activity" targetRef="m_cmpmerge" />
    <bpmn:sequenceFlow id="Flow_9" name="" sourceRef="m_cmpmerge" targetRef="m_cmp" />
    <bpmn:sequenceFlow id="Flow_10" name="" sourceRef="m_cmp" targetRef="m_sig" />
    <bpmn:sequenceFlow id="Flow_11" name="yes" sourceRef="m_sig" targetRef="m_dev" />
    <bpmn:sequenceFlow id="Flow_12" name="no" sourceRef="m_sig" targetRef="m_merge" />
    <bpmn:sequenceFlow id="Flow_13" name="" sourceRef="m_dev" targetRef="m_merge" />
    <bpmn:sequenceFlow id="Flow_14" name="" sourceRef="m_load2" targetRef="m_merge" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collab_monitoring">
      <bpmndi:BPMNShape id="P_trainee_di" bpmnElement="P_trainee" isHorizontal="false">
        <dc:Bounds x="0" y="0" width="50" height="1225" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_mon_di" bpmnElement="P_mon" isHorizontal="false">
        <dc:Bounds x="95" y="0" width="375" height="1225" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_act_di" bpmnElement="P_act" isHorizontal="false">
        <dc:Bounds x="515" y="0" width="50" height="1225" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_coord_di" bpmnElement="P_coord" isHorizontal="false">
        <dc:Bounds x="610" y="0" width="50" height="1225" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="m_start_di" bpmnElement="m_start">
        <dc:Bounds x="264.5" y="94.5" width="36.0" height="36.0" />
        <bpmndi:BPMNLabel><dc:Bounds x="287.5" y="132.5" width="68" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="m_load_di" bpmnElement="m_load">
        <dc:Bounds x="232.5" y="177.5" width="100.0" height="80.0" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="m_merge_di" bpmnElement="m_merge" isMarkerVisible="true">
        <dc:Bounds x="257.5" y="297.5" width="50.0" height="50.0" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="m_evgw_di" bpmnElement="m_evgw">
        <dc:Bounds x="257.5" y="402.5" width="50.0" height="50.0" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="m_survey_di" bpmnElement="m_survey">
        <dc:Bounds x="139.5" y="514.5" width="36.0" height="36.0" />
        <bpmndi:BPMNLabel><dc:Bounds x="162.5" y="552.5" width="68" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="m_activity_di" bpmnElement="m_activity">
        <dc:Bounds x="264.5" y="724.5" width="36.0" height="36.0" />
        <bpmndi:BPMNLabel><dc:Bounds x="287.5" y="762.5" width="68" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="m_upd_di" bpmnElement="m_upd">
        <dc:Bounds x="389.5" y="514.5" width="36.0" height="36.0" />
        <bpmndi:BPMNLabel><dc:Bounds x="412.5" y="552.5" width="68" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="m_load2_di" bpmnElement="m_load2">
        <dc:Bounds x="357.5" y="597.5" width="100.0" height="80.0" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="m_cmpmerge_di" bpmnElement="m_cmpmerge" isMarkerVisible="true">
        <dc:Bounds x="257.5" y="822.5" width="50.0" height="50.0" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="m_cmp_di" bpmnElement="m_cmp">
        <dc:Bounds x="232.5" y="912.5" width="100.0" height="80.0" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="m_sig_di" bpmnElement="m_sig" isMarkerVisible="true">
        <dc:Bounds x="257.5" y="1032.5" width="50.0" height="50.0" />
        <bpmndi:BPMNLabel><dc:Bounds x="290.5" y="1009.5" width="82" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="m_dev_di" bpmnElement="m_dev">
        <dc:Bounds x="264.5" y="1144.5" width="36.0" height="36.0" />
        <bpmndi:BPMNLabel><dc:Bounds x="287.5" y="1182.5" width="68" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_0_di" bpmnElement="Flow_0">
        <di:waypoint x="282.5" y="130.5" />
        <di:waypoint x="282.5" y="177.5" />
      </bpmndi:BPMNEdge>
