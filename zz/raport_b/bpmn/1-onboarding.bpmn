<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_onboarding" targetNamespace="http://bpmn.io/schema/bpmn" exporter="hand-written" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_onboarding" name="Process 1 - Onboarding and initial plan">
    <bpmn:participant id="P_trainee" name="Trainee (web app)" />
    <bpmn:participant id="P_coord" name="Coordinator agent" processRef="Proc_coord" />
    <bpmn:participant id="P_know" name="Knowledge agent" processRef="Proc_know" />
    <bpmn:participant id="P_web" name="Web search" />
    <bpmn:participant id="P_plan" name="Planning agent" processRef="Proc_plan" />
    <bpmn:participant id="P_cal" name="Calendar service" />
    <bpmn:participant id="P_expl" name="Explanation agent" processRef="Proc_expl" />
    <bpmn:participant id="P_mon" name="Monitoring agent" />
    <bpmn:messageFlow id="Msg_trainee_o_start" name="profile" sourceRef="P_trainee" targetRef="o_start" />
    <bpmn:messageFlow id="Msg_o_ask_trainee" name="questions" sourceRef="o_ask" targetRef="P_trainee" />
    <bpmn:messageFlow id="Msg_trainee_o_answers" name="answers" sourceRef="P_trainee" targetRef="o_answers" />
    <bpmn:messageFlow id="Msg_o_reqk_k_start" name="research query" sourceRef="o_reqk" targetRef="k_start" />
    <bpmn:messageFlow id="Msg_k_search_web" name="search query" sourceRef="k_search" targetRef="P_web" />
    <bpmn:messageFlow id="Msg_web_k_search" name="results" sourceRef="P_web" targetRef="k_search" />
    <bpmn:messageFlow id="Msg_k_end_o_gotk" name="knowledge brief" sourceRef="k_end" targetRef="o_gotk" />
    <bpmn:messageFlow id="Msg_o_reqp_p_start" name="plan request" sourceRef="o_reqp" targetRef="p_start" />
    <bpmn:messageFlow id="Msg_p_cal_cal" name="free/busy query" sourceRef="p_cal" targetRef="P_cal" />
    <bpmn:messageFlow id="Msg_cal_p_cal" name="free/busy" sourceRef="P_cal" targetRef="p_cal" />
    <bpmn:messageFlow id="Msg_p_end_o_gotp" name="proposal" sourceRef="p_end" targetRef="o_gotp" />
    <bpmn:messageFlow id="Msg_o_reqe_e_start" name="proposal" sourceRef="o_reqe" targetRef="e_start" />
    <bpmn:messageFlow id="Msg_e_end_o_gote" name="explanation" sourceRef="e_end" targetRef="o_gote" />
    <bpmn:messageFlow id="Msg_o_present_trainee" name="proposal + explanation" sourceRef="o_present" targetRef="P_trainee" />
    <bpmn:messageFlow id="Msg_trainee_o_decision" name="decision (+ reason)" sourceRef="P_trainee" targetRef="o_decision" />
    <bpmn:messageFlow id="Msg_o_noplan_trainee" name="no plan saved" sourceRef="o_noplan" targetRef="P_trainee" />
    <bpmn:messageFlow id="Msg_o_calendar_cal" name="workout events" sourceRef="o_calendar" targetRef="P_cal" />
    <bpmn:messageFlow id="Msg_o_startmon_mon" name="accepted plan" sourceRef="o_startmon" targetRef="P_mon" />
    <bpmn:messageFlow id="Msg_o_done_trainee" name="confirmation" sourceRef="o_done" targetRef="P_trainee" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_coord" isExecutable="false">
    <bpmn:laneSet id="LaneSet_coord">
      <bpmn:lane id="Lane_uh" name="UserHandler">
        <bpmn:flowNodeRef>o_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_save</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_ask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_answers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_update</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_present</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_wm" name="WorkflowManager">
        <bpmn:flowNodeRef>o_reqk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_gotk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_retry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_reqp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_gotp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_reqe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_gote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_accepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_attempts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_noplan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_commit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_calendar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_startmon</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_pm" name="ProfileManager">
        <bpmn:flowNodeRef>o_assess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>o_questions</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="o_start" name="Onboarding form received"><bpmn:outgoing>Flow_o_start_o_save</bpmn:outgoing><bpmn:messageEventDefinition id="o_start_md" /></bpmn:startEvent>
    <bpmn:task id="o_save" name="Save profile draft"><bpmn:incoming>Flow_o_start_o_save</bpmn:incoming><bpmn:outgoing>Flow_o_save_o_assess</bpmn:outgoing></bpmn:task>
    <bpmn:task id="o_assess" name="Assess profile"><bpmn:incoming>Flow_o_save_o_assess</bpmn:incoming><bpmn:incoming>Flow_o_update_o_assess</bpmn:incoming><bpmn:outgoing>Flow_o_assess_o_complete</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="o_complete" name="Profile complete?"><bpmn:incoming>Flow_o_assess_o_complete</bpmn:incoming><bpmn:outgoing>Flow_o_complete_o_questions</bpmn:outgoing><bpmn:outgoing>Flow_o_complete_o_reqk</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="o_questions" name="Draft clarifying questions"><bpmn:incoming>Flow_o_complete_o_questions</bpmn:incoming><bpmn:outgoing>Flow_o_questions_o_ask</bpmn:outgoing></bpmn:task>
    <bpmn:intermediateThrowEvent id="o_ask" name="Send questions"><bpmn:incoming>Flow_o_questions_o_ask</bpmn:incoming><bpmn:outgoing>Flow_o_ask_o_answers</bpmn:outgoing><bpmn:messageEventDefinition id="o_ask_md" /></bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="o_answers" name="Answers received"><bpmn:incoming>Flow_o_ask_o_answers</bpmn:incoming><bpmn:outgoing>Flow_o_answers_o_update</bpmn:outgoing><bpmn:messageEventDefinition id="o_answers_md" /></bpmn:intermediateCatchEvent>
    <bpmn:task id="o_update" name="Update profile"><bpmn:incoming>Flow_o_answers_o_update</bpmn:incoming><bpmn:outgoing>Flow_o_update_o_assess</bpmn:outgoing></bpmn:task>
    <bpmn:intermediateThrowEvent id="o_reqk" name="Request knowledge"><bpmn:incoming>Flow_o_complete_o_reqk</bpmn:incoming><bpmn:outgoing>Flow_o_reqk_o_gotk</bpmn:outgoing><bpmn:messageEventDefinition id="o_reqk_md" /></bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="o_gotk" name="Brief received"><bpmn:incoming>Flow_o_reqk_o_gotk</bpmn:incoming><bpmn:outgoing>Flow_o_gotk_o_retry</bpmn:outgoing><bpmn:messageEventDefinition id="o_gotk_md" /></bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="o_retry" name=""><bpmn:incoming>Flow_o_gotk_o_retry</bpmn:incoming><bpmn:incoming>Flow_o_attempts_o_retry</bpmn:incoming><bpmn:outgoing>Flow_o_retry_o_reqp</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="o_reqp" name="Request plan"><bpmn:incoming>Flow_o_retry_o_reqp</bpmn:incoming><bpmn:outgoing>Flow_o_reqp_o_gotp</bpmn:outgoing><bpmn:messageEventDefinition id="o_reqp_md" /></bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="o_gotp" name="Proposal received"><bpmn:incoming>Flow_o_reqp_o_gotp</bpmn:incoming><bpmn:outgoing>Flow_o_gotp_o_reqe</bpmn:outgoing><bpmn:messageEventDefinition id="o_gotp_md" /></bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="o_reqe" name="Request explanation"><bpmn:incoming>Flow_o_gotp_o_reqe</bpmn:incoming><bpmn:outgoing>Flow_o_reqe_o_gote</bpmn:outgoing><bpmn:messageEventDefinition id="o_reqe_md" /></bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="o_gote" name="Explanation received"><bpmn:incoming>Flow_o_reqe_o_gote</bpmn:incoming><bpmn:outgoing>Flow_o_gote_o_present</bpmn:outgoing><bpmn:messageEventDefinition id="o_gote_md" /></bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="o_present" name="Present proposal"><bpmn:incoming>Flow_o_gote_o_present</bpmn:incoming><bpmn:outgoing>Flow_o_present_o_decision</bpmn:outgoing><bpmn:messageEventDefinition id="o_present_md" /></bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="o_decision" name="Decision received"><bpmn:incoming>Flow_o_present_o_decision</bpmn:incoming><bpmn:outgoing>Flow_o_decision_o_accepted</bpmn:outgoing><bpmn:messageEventDefinition id="o_decision_md" /></bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="o_accepted" name="Accepted?"><bpmn:incoming>Flow_o_decision_o_accepted</bpmn:incoming><bpmn:outgoing>Flow_o_accepted_o_commit</bpmn:outgoing><bpmn:outgoing>Flow_o_accepted_o_attempts</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="o_attempts" name="Attempts left?"><bpmn:incoming>Flow_o_accepted_o_attempts</bpmn:incoming><bpmn:outgoing>Flow_o_attempts_o_retry</bpmn:outgoing><bpmn:outgoing>Flow_o_attempts_o_noplan</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="o_noplan" name="Trainee told no plan was saved"><bpmn:incoming>Flow_o_attempts_o_noplan</bpmn:incoming><bpmn:messageEventDefinition id="o_noplan_md" /></bpmn:endEvent>
    <bpmn:task id="o_commit" name="Save plan version"><bpmn:incoming>Flow_o_accepted_o_commit</bpmn:incoming><bpmn:outgoing>Flow_o_commit_o_calendar</bpmn:outgoing></bpmn:task>
    <bpmn:task id="o_calendar" name="Write workouts to calendar"><bpmn:incoming>Flow_o_commit_o_calendar</bpmn:incoming><bpmn:outgoing>Flow_o_calendar_o_startmon</bpmn:outgoing></bpmn:task>
    <bpmn:intermediateThrowEvent id="o_startmon" name="Start monitoring"><bpmn:incoming>Flow_o_calendar_o_startmon</bpmn:incoming><bpmn:outgoing>Flow_o_startmon_o_done</bpmn:outgoing><bpmn:messageEventDefinition id="o_startmon_md" /></bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="o_done" name="Plan confirmed"><bpmn:incoming>Flow_o_startmon_o_done</bpmn:incoming><bpmn:messageEventDefinition id="o_done_md" /></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_o_start_o_save" sourceRef="o_start" targetRef="o_save" />
    <bpmn:sequenceFlow id="Flow_o_save_o_assess" sourceRef="o_save" targetRef="o_assess" />
    <bpmn:sequenceFlow id="Flow_o_assess_o_complete" sourceRef="o_assess" targetRef="o_complete" />
    <bpmn:sequenceFlow id="Flow_o_complete_o_questions" name="no" sourceRef="o_complete" targetRef="o_questions" />
    <bpmn:sequenceFlow id="Flow_o_questions_o_ask" sourceRef="o_questions" targetRef="o_ask" />
    <bpmn:sequenceFlow id="Flow_o_ask_o_answers" sourceRef="o_ask" targetRef="o_answers" />
    <bpmn:sequenceFlow id="Flow_o_answers_o_update" sourceRef="o_answers" targetRef="o_update" />
    <bpmn:sequenceFlow id="Flow_o_update_o_assess" sourceRef="o_update" targetRef="o_assess" />
    <bpmn:sequenceFlow id="Flow_o_complete_o_reqk" name="yes" sourceRef="o_complete" targetRef="o_reqk" />
    <bpmn:sequenceFlow id="Flow_o_reqk_o_gotk" sourceRef="o_reqk" targetRef="o_gotk" />
    <bpmn:sequenceFlow id="Flow_o_gotk_o_retry" sourceRef="o_gotk" targetRef="o_retry" />
    <bpmn:sequenceFlow id="Flow_o_retry_o_reqp" sourceRef="o_retry" targetRef="o_reqp" />
    <bpmn:sequenceFlow id="Flow_o_reqp_o_gotp" sourceRef="o_reqp" targetRef="o_gotp" />
    <bpmn:sequenceFlow id="Flow_o_gotp_o_reqe" sourceRef="o_gotp" targetRef="o_reqe" />
    <bpmn:sequenceFlow id="Flow_o_reqe_o_gote" sourceRef="o_reqe" targetRef="o_gote" />
    <bpmn:sequenceFlow id="Flow_o_gote_o_present" sourceRef="o_gote" targetRef="o_present" />
    <bpmn:sequenceFlow id="Flow_o_present_o_decision" sourceRef="o_present" targetRef="o_decision" />
    <bpmn:sequenceFlow id="Flow_o_decision_o_accepted" sourceRef="o_decision" targetRef="o_accepted" />
    <bpmn:sequenceFlow id="Flow_o_accepted_o_commit" name="yes" sourceRef="o_accepted" targetRef="o_commit" />
    <bpmn:sequenceFlow id="Flow_o_accepted_o_attempts" name="no" sourceRef="o_accepted" targetRef="o_attempts" />
    <bpmn:sequenceFlow id="Flow_o_attempts_o_retry" name="yes" sourceRef="o_attempts" targetRef="o_retry" />
    <bpmn:sequenceFlow id="Flow_o_attempts_o_noplan" name="no" sourceRef="o_attempts" targetRef="o_noplan" />
    <bpmn:sequenceFlow id="Flow_o_commit_o_calendar" sourceRef="o_commit" targetRef="o_calendar" />
    <bpmn:sequenceFlow id="Flow_o_calendar_o_startmon" sourceRef="o_calendar" targetRef="o_startmon" />
    <bpmn:sequenceFlow id="Flow_o_startmon_o_done" sourceRef="o_startmon" targetRef="o_done" />
  </bpmn:process>
  <bpmn:process id="Proc_know" isExecutable="false">
    <bpmn:startEvent id="k_start" name="Research query received"><bpmn:outgoing>Flow_k_start_k_search</bpmn:outgoing><bpmn:messageEventDefinition id="k_start_md" /></bpmn:startEvent>
    <bpmn:task id="k_search" name="Search the web"><bpmn:incoming>Flow_k_start_k_search</bpmn:incoming><bpmn:outgoing>Flow_k_search_k_rate</bpmn:outgoing></bpmn:task>
    <bpmn:task id="k_rate" name="Rate source credibility"><bpmn:incoming>Flow_k_search_k_rate</bpmn:incoming><bpmn:outgoing>Flow_k_rate_k_brief</bpmn:outgoing></bpmn:task>
    <bpmn:task id="k_brief" name="Compile brief with references"><bpmn:incoming>Flow_k_rate_k_brief</bpmn:incoming><bpmn:outgoing>Flow_k_brief_k_end</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="k_end" name="Send brief"><bpmn:incoming>Flow_k_brief_k_end</bpmn:incoming><bpmn:messageEventDefinition id="k_end_md" /></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_k_start_k_search" sourceRef="k_start" targetRef="k_search" />
    <bpmn:sequenceFlow id="Flow_k_search_k_rate" sourceRef="k_search" targetRef="k_rate" />
    <bpmn:sequenceFlow id="Flow_k_rate_k_brief" sourceRef="k_rate" targetRef="k_brief" />
    <bpmn:sequenceFlow id="Flow_k_brief_k_end" sourceRef="k_brief" targetRef="k_end" />
  </bpmn:process>
  <bpmn:process id="Proc_plan" isExecutable="false">
    <bpmn:startEvent id="p_start" name="Plan request received"><bpmn:outgoing>Flow_p_start_p_cal</bpmn:outgoing><bpmn:messageEventDefinition id="p_start_md" /></bpmn:startEvent>
    <bpmn:task id="p_cal" name="Read calendar availability"><bpmn:incoming>Flow_p_start_p_cal</bpmn:incoming><bpmn:outgoing>Flow_p_cal_p_draft</bpmn:outgoing></bpmn:task>
    <bpmn:task id="p_draft" name="Draft plan up to target date"><bpmn:incoming>Flow_p_cal_p_draft</bpmn:incoming><bpmn:incoming>Flow_p_valid_p_draft</bpmn:incoming><bpmn:outgoing>Flow_p_draft_p_check</bpmn:outgoing></bpmn:task>
    <bpmn:task id="p_check" name="Check hard constraints"><bpmn:incoming>Flow_p_draft_p_check</bpmn:incoming><bpmn:outgoing>Flow_p_check_p_valid</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="p_valid" name="Valid?"><bpmn:incoming>Flow_p_check_p_valid</bpmn:incoming><bpmn:outgoing>Flow_p_valid_p_end</bpmn:outgoing><bpmn:outgoing>Flow_p_valid_p_draft</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="p_end" name="Send proposal"><bpmn:incoming>Flow_p_valid_p_end</bpmn:incoming><bpmn:messageEventDefinition id="p_end_md" /></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_p_start_p_cal" sourceRef="p_start" targetRef="p_cal" />
    <bpmn:sequenceFlow id="Flow_p_cal_p_draft" sourceRef="p_cal" targetRef="p_draft" />
    <bpmn:sequenceFlow id="Flow_p_draft_p_check" sourceRef="p_draft" targetRef="p_check" />
    <bpmn:sequenceFlow id="Flow_p_check_p_valid" sourceRef="p_check" targetRef="p_valid" />
    <bpmn:sequenceFlow id="Flow_p_valid_p_end" name="yes" sourceRef="p_valid" targetRef="p_end" />
    <bpmn:sequenceFlow id="Flow_p_valid_p_draft" name="no" sourceRef="p_valid" targetRef="p_draft" />
  </bpmn:process>
  <bpmn:process id="Proc_expl" isExecutable="false">
    <bpmn:startEvent id="e_start" name="Explanation request received"><bpmn:outgoing>Flow_e_start_e_write</bpmn:outgoing><bpmn:messageEventDefinition id="e_start_md" /></bpmn:startEvent>
    <bpmn:task id="e_write" name="Write explanation with sources"><bpmn:incoming>Flow_e_start_e_write</bpmn:incoming><bpmn:outgoing>Flow_e_write_e_end</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="e_end" name="Send explanation"><bpmn:incoming>Flow_e_write_e_end</bpmn:incoming><bpmn:messageEventDefinition id="e_end_md" /></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_e_start_e_write" sourceRef="e_start" targetRef="e_write" />
    <bpmn:sequenceFlow id="Flow_e_write_e_end" sourceRef="e_write" targetRef="e_end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_onboarding">
    <bpmndi:BPMNPlane id="Plane_onboarding" bpmnElement="Collab_onboarding">
      <bpmndi:BPMNShape id="P_trainee_di" bpmnElement="P_trainee" isHorizontal="true"><dc:Bounds x="100" y="60" width="4440" height="60" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_coord_di" bpmnElement="P_coord" isHorizontal="true"><dc:Bounds x="100" y="170" width="4440" height="470" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_uh_di" bpmnElement="Lane_uh" isHorizontal="true"><dc:Bounds x="130" y="170" width="4410" height="120" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_wm_di" bpmnElement="Lane_wm" isHorizontal="true"><dc:Bounds x="130" y="290" width="4410" height="230" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_pm_di" bpmnElement="Lane_pm" isHorizontal="true"><dc:Bounds x="130" y="520" width="4410" height="120" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_know_di" bpmnElement="P_know" isHorizontal="true"><dc:Bounds x="100" y="690" width="4440" height="120" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_web_di" bpmnElement="P_web" isHorizontal="true"><dc:Bounds x="100" y="860" width="4440" height="60" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_plan_di" bpmnElement="P_plan" isHorizontal="true"><dc:Bounds x="100" y="970" width="4440" height="120" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_cal_di" bpmnElement="P_cal" isHorizontal="true"><dc:Bounds x="100" y="1140" width="4440" height="60" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_expl_di" bpmnElement="P_expl" isHorizontal="true"><dc:Bounds x="100" y="1250" width="4440" height="120" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P_mon_di" bpmnElement="P_mon" isHorizontal="true"><dc:Bounds x="100" y="1420" width="4440" height="60" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="o_start_di" bpmnElement="o_start"><dc:Bounds x="212" y="212" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="175" y="252" width="110" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="o_save_di" bpmnElement="o_save"><dc:Bounds x="320" y="190" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="o_assess_di" bpmnElement="o_assess"><dc:Bounds x="460" y="540" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="o_complete_di" bpmnElement="o_complete" isMarkerVisible="true"><dc:Bounds x="625" y="555" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="595" y="609" width="110" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
